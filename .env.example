ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Used when the Claude API returns an error. Claude is always tried first.
# RESEARCH_FALLBACK=foundry
# Claude on Foundry uses the Messages API. A name starting with claude
# selects that path; any other model uses the OpenAI Responses API.
# FOUNDRY_ENDPOINT=https://YOUR-RESOURCE-NAME.services.ai.azure.com
# FOUNDRY_API_KEY=
# FOUNDRY_MODEL=claude-sonnet-4-6
WEB_SEARCH_TOOL_TYPE=web_search_20250305
MAX_SEARCH_USES=5
DELIVERY_MODE=outbox
FROM_NAME=Earned Media Roundup
BLAST_TO=
MAIL_FROM=
# Testing: send every email to MAIL_FROM only, with [TEST] in the subject.
SEND_TO_SELF=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# On the Function App these are GRAPH_CLIENT_ID (and GRAPH_CLIENT_SECRET for app-only send).
# Application Mail.Send secret. Leave unset to send as the signed-in user.
# AZURE_CLIENT_SECRET=
# Function App only: read the device-code login from Key Vault instead of data/.
# Upload it with: python -m pipeline auth --upload --vault-url https://kv-tlb-emo.vault.azure.net/
# GRAPH_TOKEN_VAULT_URL=
# GRAPH_TOKEN_SECRET=graph-token-cache
# sqlite locally, tables on the Function App
# STORAGE_BACKEND=tables
# AZURE_STORAGE_ACCOUNT=
# file locally, blob on the Function App
# ROSTER_SOURCE=blob
# ROSTER_BLOB_CONTAINER=roster
# ROSTER_BLOB_NAME=TLB PortCo SME List.xlsx
# OUTBOX_DIR=/tmp/outbox
# graph = write outbox files and send via Microsoft Graph (device-code login)
# DELIVERY_MODE=graph
# Set to true to force stub research even on a live `pipeline run`
DRY_RUN_RESEARCH=false

# Site traffic — Cloudflare Radar domain rank (DNS queries to 1.1.1.1).
# Create a token at https://dash.cloudflare.com/profile/api-tokens
# with Account → Radar → Read. The global top 100 have an exact rank; other
# ranked domains are a bucket such as top 10K. Radar does not return an
# estimated visit count. Without the token, the roundup omits the Site line.
CLOUDFLARE_API_TOKEN=
RADAR_CACHE_DAYS=7

# Spotify audience for podcast opportunities only. The public show object
# usually omits subscriber and monthly listener counts; the roundup prints
# them when a response includes followers or monthly_listeners, and otherwise
# shows episode count, publisher, and the newest episode.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
PODCAST_CACHE_DAYS=7

# Yes/No links in the roundup. Must be a URL the email reader can open.
# Leave blank to omit the links. For this machine only:
# FEEDBACK_PUBLIC_URL=http://127.0.0.1:8787
FEEDBACK_PUBLIC_URL=
FEEDBACK_BIND=127.0.0.1
FEEDBACK_PORT=8787
